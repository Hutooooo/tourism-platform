node_modules/
dist/
build/

# Secrets — never commit. config.js loads ./.env then ./server/.env as an
# override, so both locations matter. Block every variant so a stray
# .env.production or deploy.env can never be picked up.
.env
.env.*
*.env
!.env.example

*.log
npm-debug.log*

