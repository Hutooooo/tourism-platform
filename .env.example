# --- Server ---
# Port the API listens on. Cloud hosts usually inject PORT for you.
PORT=4000
# Interface to bind. Leave as 0.0.0.0 so reverse proxies and containers can reach it.
HOST=0.0.0.0
# Must be "production" on a public deployment.
NODE_ENV=development

# Absolute URL of the API, used for canonical/OG URLs and the bootstrap
# `api.baseUrl` field. OPTIONAL: when unset the server derives the origin
# from each request's Host header, so a visitor is never handed localhost.
# Set it explicitly to pin the origin, e.g.:
#   PUBLIC_API_URL=https://ceylonitalia.up.railway.app
PUBLIC_API_URL=http://localhost:4000

# Comma separated list of allowed browser origins (CORS).
# Same-origin deployments need only the site origin itself, e.g.:
#   CLIENT_ORIGINS=https://example.com
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Persistence ---
# SQLite database file, relative to the server/ directory.
DATABASE_FILE=./data/app.db

# Directory where uploaded images are stored, relative to server/.
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# --- Auth ---
# Generate strong secrets before deploying, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=15m
REFRESH_JWT_SECRET=change-me-to-a-different-long-random-string
REFRESH_JWT_TTL=30d
COOKIE_SECURE=false

# --- Seeded administrator (created on first run / npm run seed) ---
ADMIN_EMAIL=admin@localhost.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator
