# Keep the build context identical to what the repo contains, so a local
# `docker build` behaves exactly like Railway's (which builds from git).

# Dependencies: the Dockerfile installs its own Linux copies in earlier
# layers. Copying a local (Windows) node_modules over them would clobber the
# better-sqlite3 native binary.
node_modules
**/node_modules

# Build output is regenerated by `npm run build` inside the image.
client/dist

# Runtime state — never bake a developer's database or uploaded images into
# a production image. The container starts empty and `npm run seed` fills it.
server/data
server/uploads
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Credentials. The image must get JWT_SECRET, REFRESH_JWT_SECRET, ADMIN_*
# etc. from the platform's environment, not from a file on the build machine.
.env
.env.*
*.env
!.env.example

.git
.gitignore
*.log
.DS_Store
Thumbs.db
